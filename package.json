{
  "name": "dove",
  "version": "3.2.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs && node scripts/make-icons.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "pnpm run assets && vite",
    "build": "pnpm run assets && pnpm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.e2e.json",
    "preview": "vite preview",
    "serve": "pnpm run build && node scripts/serve.mjs",
    "serve:tunnel": "pnpm run build && node scripts/serve.mjs --tunnel",
    "test": "node --test src/**/*.test.ts",
    "dict": "node scripts/build-dict.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:pwa": "pnpm run build && playwright test --project=pwa-chromium",
    "e2e:pwa:legacy": "node scripts/e2e-pwa.mjs",
    "e2e:pwa:report": "playwright show-report",
    "e2e:devices": "playwright test --config=playwright.devices.config.ts",
    "e2e:browserstack": "playwright test --config=playwright.browserstack.config.ts",
    "e2e:catalog": "node scripts/check-e2e-catalog.mjs",
    "test:ci": "pnpm test && pnpm run e2e:catalog && pnpm run e2e:pwa",
    "sample": "node scripts/make-sample.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^7.0.0"
  },
  "type": "module"
}
