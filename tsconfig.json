{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // sw.js 走 tsconfig.sw.json，它要的是 WebWorker 而不是 DOM 的类型
  "include": ["src"],
  "exclude": ["src/sw.js", "src/sw-globals.d.ts"]
}
